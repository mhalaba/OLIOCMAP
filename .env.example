# Tożsamość węzła (wymagane). NODE_ID: [a-z0-9-], unikalny w federacji.
NODE_ID=bytom-01
NODE_ROLE=node
NODE_NAME=OSP Bytom-Szombierki
NODE_GMINA_TERYT=2462011
NODE_GMINA_NAME=Bytom
NODE_OPERATOR_NAME=OSP Bytom-Szombierki

# Peers: JSON array [{node_id, base_url}] — puste = tryb wyspa.
# Adresuj Caddy peera (port 80 w sieci docker), nigdy PocketBase bezpośrednio.
PEERS=
# Skrót: jeśli ustawione, dodaje peera {node_id:"central-01", base_url}
CENTRAL_URL=
SYNC_INTERVAL_S=30

# Publiczna geometria dla lacznosc / prywatny prad: precise | gmina | hidden
PUBLIC_GEOM_MODE=gmina

# Rejestracja: open | invite | closed
REGISTRATION_MODE=open
AUTO_VERIFY_TRUSTED=false

# Zgłoszenia potrzeb: TTL w godzinach, potem status=expired; +7 dni = czyszczenie pól
POTRZEBA_TTL_H=72
CONFIRM_INTERVAL_DAYS=14

# TLS: off (HTTP, PWA bez SW) | internal (Caddy CA) | file (własny cert)
TLS_MODE=off
TLS_CERT_FILE=
TLS_KEY_FILE=

# Superuserzy PocketBase (pierwszy boot, migracja). Zmień hasła przed produkcją.
PB_SUPERUSER_EMAIL=admin@node.local
PB_SUPERUSER_PASSWORD=change-me
SYNC_SUPERUSER_EMAIL=sync@node.local
SYNC_SUPERUSER_PASSWORD=change-me-too

# Wersja aplikacji (stopka /status)
APP_VERSION=0.1.0

# Import AED z OpenAEDMap (bundled = paczka w obrazie, fetch = pobierz z internetu, off = wyłącz)
AED_IMPORT=bundled
# Opcjonalny wycinek: minLon,minLat,maxLon,maxLat — puste = cała Polska z paczki
AED_BBOX=
AED_BUNDLE_PATH=/app/data/openaedmap-pl.geojson.gz

# Kafelki offline (PMTiles). Pobieranie z /status (operator), gdy jest internet.
TILES_DIR=/tiles
TILES_BBOX=18.82,50.30,18.98,50.42
TILES_MAXZOOM=14
PMTILES_SOURCE=https://build.protomaps.com/20260904.pmtiles
